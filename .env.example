# ==========================================
# LifeMap Environment Configuration
# ==========================================

# Supabase Client Configuration (Exposed to browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Only Credentials (NEVER exposed to frontend bundle)
# Used by the backend proxy endpoint for secure AI chat
LLM_API_KEY=your-server-side-llm-api-key
LLM_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
